# AI Terminal Integration - 環境變數設定
# 複製此檔案為 .env 並修改為您的設定

# 部署目標路徑（Obsidian 外掛目錄）
# macOS 範例:
DEPLOY_TARGET="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault/.obsidian/plugins"

# Windows 範例:
# DEPLOY_TARGET="$HOME/AppData/Roaming/obsidian/YourVault/.obsidian/plugins"

# Linux 範例:
# DEPLOY_TARGET="$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/YourVault/.obsidian/plugins"